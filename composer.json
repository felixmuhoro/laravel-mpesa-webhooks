{
    "name": "felixmuhoro/laravel-mpesa-webhooks",
    "description": "Advanced M-Pesa webhook handling for Laravel — signature verification, idempotency, retry logic, logging, and a webhook dashboard.",
    "type": "library",
    "keywords": ["laravel", "mpesa", "webhooks", "safaricom", "stk", "c2b", "b2c"],
    "license": "MIT",
    "authors": [
        {
            "name": "Felix Muhoro",
            "email": "felix@felixmuhoro.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "felixmuhoro/laravel-mpesa": "^1.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FelixMuhoro\\\\MpesaWebhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FelixMuhoro\\\\MpesaWebhooks\\\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FelixMuhoro\\\\MpesaWebhooks\\\\MpesaWebhooksServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
